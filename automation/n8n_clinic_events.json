              "id": "f0bba716-822c-5e6b-8c5b-88d90f12382f",
              "name": "text",
              "value": "=A new appointment was booked through the website assistant.\n\nPatient:  {{ $('Clinic events').item.json.body.data.name }}\nPhone:    {{ $('Clinic events').item.json.body.data.phone }}\nEmail:    {{ $('Clinic events').item.json.body.data.email || 'not given' }}\nVisit:    {{ $('Clinic events').item.json.body.data.visit_label }} with {{ $('Clinic events').item.json.body.data.provider }}\nWhen:     {{ $('Clinic events').item.json.body.data.when }}\nReason:   {{ $('Clinic events').item.json.body.data.reason || 'not given' }}\n\nAppointment #{{ $('Clinic events').item.json.body.data.appointment_id }}. It's also in the Bookings sheet.\nPlease verify insurance before the visit.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
