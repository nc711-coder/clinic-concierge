# Copy to .env and fill in. .env is git-ignored.

# Postgres with pgvector. On Supabase, copy the connection string from your project's Connect panel.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Which embedder makes the vectors:
#   local  = free, runs on your PC (BAAI/bge-small-en-v1.5, 384 dims). No API key.   <- default
#   openai = text-embedding-3-small (1536 dims). Needs OPENAI_API_KEY.
#   hash   = fake vectors for tests only
EMBEDDER=local

# Optional overrides
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=text-embedding-3-small      (OpenAI only)

# Cross-encoder reranker on the top 30 search results: local (default, free, ~80 MB) | none
RERANKER=local
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Which language model writes the answers: ollama (free, local) | groq (paid, used for the live demo)
# | gemini | openai | anthropic
LLM_PROVIDER=ollama

# ollama: download the model once with `ollama pull llama3.2:3b`. With 16 GB+ RAM, llama3.1:8b answers better.
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434

# gemini: free API key from https://aistudio.google.com/apikey (no card). If the model name is ever retired,
# the error message lists the ones your key can use.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_REASONING_EFFORT=low
# If the main model doesn't answer within 20 s (free tiers sometimes hang), one retry, then this lighter model
# answers instead. 'none' turns it off. LLM_TIMEOUT changes the 20 s.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# groq: key from https://console.groq.com/keys. Used for the live demo on the paid Developer plan (about a
# tenth of a cent per message). The free tier allows only ~8,000 tokens a minute (about 2 messages).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# openai: needs OPENAI_API_KEY (below). Reasoning models (gpt-5 family) think first; effort: minimal|low|medium|high
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low

# anthropic: needs ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# Relevance gate: if the best reranker score is below this, reply "I don't have that information"
# without asking the model. Lower = answers more questions, higher = refuses more. Tune with the eval set.
# CHAT_MIN_RERANK_SCORE=-5

# Bookings and handoffs are POSTed here as JSON ({"event": ..., "data": ...}): the n8n webhook from
# automation/README.md. Leave unset to skip notifications. Test with: python -m app.notify
# EVENT_WEBHOOK_URL=http://localhost:5678/webhook/clinic-events
# Sent as the X-Webhook-Secret header; must match the n8n Header Auth credential. Use a long random value.
# EVENT_WEBHOOK_SECRET=

# Websites allowed to call the API from a browser (the chat widget), comma-separated. The demo site served
# by this app needs nothing here. Default * = any site; for a real client, list only their domain(s).
# ALLOWED_ORIGINS=https://www.quillmere-pt.example,https://quillmere-pt.example

# Public demo limits (off unless set): messages per visitor per hour, and for everyone per day.
# MESSAGES_PER_HOUR_PER_VISITOR=40
# MESSAGES_PER_DAY=300

# For EMBEDDER=openai or LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only needed if Tesseract isn't on PATH or in the default Windows folder
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
